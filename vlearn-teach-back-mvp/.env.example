# VLearn Teach-Back MVP — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT:
#   * Do NOT commit the real .env file. The .env is git-ignored.
#   * API keys are sensitive — keep them out of any committed file.

# ===========================================================================
# Teach-Back loop (track D3) — the chat model the agent runs on
# ===========================================================================
# TEACH_BACK_PROVIDER:
#   openai-compatible  any /chat/completions endpoint (DeepSeek, OpenAI, …)
#   gemini             google-genai SDK (requires `pip install google-genai`)
#   mock               offline; heuristics only, zero paid calls
TEACH_BACK_PROVIDER=openai-compatible
TEACH_BACK_BASE_URL=https://api.deepseek.com
TEACH_BACK_MODEL=deepseek-flash
TEACH_BACK_API_KEY=

# deepseek-flash is a reasoning model: part of the token budget goes to its
# scratchpad before the JSON answer appears. Leave headroom here, or the
# reply comes back empty.
TEACH_BACK_MAX_TOKENS=5000
TEACH_BACK_TIMEOUT=90

# A lecture transcript holds 11–21 sections. A session keeps only the most
# substantial ones so teaching back stays a 5–10 minute activity.
TEACH_BACK_MAX_CHUNKS=5

# After this many attempts on one chunk the agent stops asking back and lets
# the student move on, flagged "cần xem lại". Practice, not an exam.
TEACH_BACK_MAX_ATTEMPTS=4

# ===========================================================================
# Lesson sources
# ===========================================================================
# The VLearn data pack (transcripts + slides). Read-only: the app never
# writes here and never copies the pack into the repository.
VLEARN_PACK_DIR=../data/vlearn-pack

# Optional: a directory of slide PDFs to add as lessons. Left at the default
# (which does not exist) the catalogue is transcript-only — the hackathon
# decks carry a page watermark that the extractor mistakes for section
# headings, so they make poor teach-back chunks.
#   VLEARN_LESSON_DIR=../data/vlearn-pack/slides
VLEARN_LESSON_DIR=../data/lesson

# ===========================================================================
# Documentizer (Phase 3A.5) — PDF -> StructuredLesson. Separate from the
# teach-back loop above and only used by the documentizer CLI/routes.
# ===========================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=mock

# Max AI attempts before giving up on a single document.
DOC3A5_MAX_ATTEMPTS=3
# Grounding-strict retry attempts (1..N-1).
DOC3A5_GROUNDING_RETRY_ATTEMPTS=1
# Linear backoff base (seconds) between attempts.
DOC3A5_BACKOFF_SECONDS=1
# Source language hint: "en", "vi", or "auto".
DOC3A5_LANGUAGE=auto
# Teach-Back chunk target range (semantic chunking; not a hard limit).
DOC3A5_CHUNKS_MIN=3
DOC3A5_CHUNKS_MAX=12
# Source grounding score must be at or above this to pass (0..1).
DOC3A5_GROUNDING_THRESHOLD=0.80
# Page coverage floor for non-blank pages (0..1).
DOC3A5_PAGE_COVERAGE_FLOOR=0.60
# Minimum per-chunk confidence for the confidence gate (0..1).
DOC3A5_MIN_CONFIDENCE=0.65
# Render page images for visual slides. Off by default.
DOC3A5_ENABLE_PAGE_IMAGES=false
DOC3A5_PAGE_IMAGE_DPI=150
