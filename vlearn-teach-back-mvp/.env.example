# VLearn Teach-Back MVP - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT:
#   * Do NOT commit the real .env file. The .env is git-ignored.
#   * GEMINI_API_KEY is sensitive — keep it out of any committed file.
#   * GEMINI_MODEL is the model name (e.g. gemini-2.5-flash). Default below.
#   * AI_PROVIDER selects the provider. "gemini" is the production path;
#     "mock" is for tests / offline runs.

# ---- AI provider ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# ---- Phase 3A.5 tuning -----------------------------------------------------
# Max AI attempts before giving up on a single document.
DOC3A5_MAX_ATTEMPTS=3
# Grounding-strict retry attempts (1..N-1).
DOC3A5_GROUNDING_RETRY_ATTEMPTS=1
# Linear backoff base (seconds) between attempts.
DOC3A5_BACKOFF_SECONDS=1
# Source language hint: "en", "vi", or "auto".
DOC3A5_LANGUAGE=auto
# Teach-Back chunk target range (semantic chunking; not a hard limit).
DOC3A5_CHUNKS_MIN=3
DOC3A5_CHUNKS_MAX=12
# Source grounding score must be at or above this to pass (0..1).
DOC3A5_GROUNDING_THRESHOLD=0.80
# Page coverage floor for non-blank pages (0..1).
DOC3A5_PAGE_COVERAGE_FLOOR=0.60
# Minimum per-chunk confidence for the confidence gate (0..1).
DOC3A5_MIN_CONFIDENCE=0.65
# Render page images for visual slides. Off by default.
DOC3A5_ENABLE_PAGE_IMAGES=false
DOC3A5_PAGE_IMAGE_DPI=150

# ---- Lesson source ---------------------------------------------------------
# Directory containing source PDF files. Relative paths are resolved
# against the project root.
VLEARN_LESSON_DIR=../data/lesson
